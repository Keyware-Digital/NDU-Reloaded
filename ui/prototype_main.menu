{
    assetGlobalDef {
        fadeClamp 1.0
        fadeCycle 1
        fadeAmount 0.1
    }

    menuDef {
        name main
        fullScreen 1
        rect 0 0 640 480
        focusColor COLOR_FOCUSED
        soundloop "music_mainmenu"
        onOpen {
            #if COOP_EPD
                open main_lockout
            #else
                open main_text;
                uiScript openMainMenuPlayerProfileScriptCallback;
                uiScript stopRefresh;
            #endif
        }
    }


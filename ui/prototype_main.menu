#define ACTION_LOCKOUT_CLOSE\
execnow "ui_cinematic prototype_main_menu 3"\
play "mouse_click";\
close main_lockout;\
setdvar ui_skipMainLockout "0"\
execnow "makeLocalClientActive;";\
open main_text;

